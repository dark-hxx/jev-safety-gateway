# 首次启动的一次性初始化变量（复制为 .env 后修改）。
# 已在数据库中存在的值不会被这些变量覆盖，后续请在控制台修改。

# 上游地址：安全请求最终转发到这里（如 new-api / OpenAI 兼容后端）
JEV_UPSTREAM_URL=http://newapi:3000

# JEV / TypeSafe 接口地址
JEV_BASE_URL=https://api.typesafe.ai

# 初始 JEV 调用密钥（可选，之后可在控制台增删多个用于轮询）
JEV_API_KEY=apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 初始管理员口令（可选；不设则首次打开控制台时在页面上设置）
JEV_ADMIN_PASSWORD=change-me-please
