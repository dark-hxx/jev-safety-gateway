# 构建产物
/jev-safety-gateway
/jev-safety-gateway.exe
# Windows 上覆盖正在运行的二进制时留下的备份（jev-safety-gateway.exe~）
/jev-safety-gateway.exe~
/out/
# 改名前的旧二进制名，避免历史残留被误提交
/gateway
/gateway.exe
/gateway.exe~

# 本地数据 / 数据库
/data/
*.db
*.db-shm
*.db-wal

# 环境变量
.env

# 编辑器
.idea/
.vscode/
.DS_Store

# 本地 Agent 工具（不纳入项目仓库）
/.codegraph/
/.claude/
/.agents/
/.codex/

# 前端工程依赖（构建产物 web/dist 提交入库，源码在 web/src）
/web/node_modules/
